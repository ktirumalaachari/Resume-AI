# ==============================================================================
# ResumeAI — Environment Variables Template
# Copy this file to .env before starting the stack:
#   cp .env.example .env
# ==============================================================================

# ── Firebase Admin SDK (Authentication) ──────────────────────────────────────
# Firebase Project ID from Google Cloud / Firebase console
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Service Account Client Email
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-firebase-project-id.iam.gserviceaccount.com

# Firebase Service Account Private Key (single-line with \n escape sequences)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# (Optional) Alternatively, supply absolute or relative path to service account JSON
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-sa.json

# ── LLM Configuration (OpenAI or Groq) ───────────────────────────────────────
# For Groq (recommended free tier):
# 1. Get free key from https://console.groq.com/keys
# 2. Set OPENAI_BASE_URL=https://api.groq.com/openai/v1
# 3. Set OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=gsk_your_groq_api_key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# For OpenAI:
# OPENAI_API_KEY=sk-proj-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ── Razorpay Payment Gateway (Billing) ────────────────────────────────────────
# Get your test/live keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Gateway Rate Limiting ────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_GLOBAL=200
RATE_LIMIT_MAX_STRICT=15
RATE_LIMIT_MAX_AUTH=10
