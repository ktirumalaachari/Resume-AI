FROM node:22-alpine AS builder
WORKDIR /app

# Copy root package and configs
COPY package*.json ./
COPY start-backend.js ./

# Copy each backend service and install/build
COPY gateway/package*.json ./gateway/
COPY gateway/tsconfig.json ./gateway/
COPY gateway/src ./gateway/src
RUN cd gateway && npm install && npm run build

COPY services/auth-service/package*.json ./services/auth-service/
COPY services/auth-service/tsconfig.json ./services/auth-service/
COPY services/auth-service/src ./services/auth-service/src
RUN cd services/auth-service && npm install && npm run build

COPY services/agent-service/package*.json ./services/agent-service/
COPY services/agent-service/tsconfig.json ./services/agent-service/
COPY services/agent-service/src ./services/agent-service/src
RUN cd services/agent-service && npm install && npm run build

COPY services/interview-service/package*.json ./services/interview-service/
COPY services/interview-service/tsconfig.json ./services/interview-service/
COPY services/interview-service/src ./services/interview-service/src
RUN cd services/interview-service && npm install && npm run build

COPY services/roadmap-service/package*.json ./services/roadmap-service/
COPY services/roadmap-service/tsconfig.json ./services/roadmap-service/
COPY services/roadmap-service/src ./services/roadmap-service/src
RUN cd services/roadmap-service && npm install && npm run build

COPY services/billing-service/package*.json ./services/billing-service/
COPY services/billing-service/tsconfig.json ./services/billing-service/
COPY services/billing-service/src ./services/billing-service/src
RUN cd services/billing-service && npm install && npm run build

# ── Production Runtime Stage ─────────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Gateway
COPY --from=builder /app/gateway/package*.json ./gateway/
COPY --from=builder /app/gateway/dist ./gateway/dist
RUN cd gateway && npm install --omit=dev

# Auth
COPY --from=builder /app/services/auth-service/package*.json ./services/auth-service/
COPY --from=builder /app/services/auth-service/dist ./services/auth-service/dist
RUN cd services/auth-service && npm install --omit=dev

# Agent
COPY --from=builder /app/services/agent-service/package*.json ./services/agent-service/
COPY --from=builder /app/services/agent-service/dist ./services/agent-service/dist
RUN cd services/agent-service && npm install --omit=dev

# Interview
COPY --from=builder /app/services/interview-service/package*.json ./services/interview-service/
COPY --from=builder /app/services/interview-service/dist ./services/interview-service/dist
RUN cd services/interview-service && npm install --omit=dev

# Roadmap
COPY --from=builder /app/services/roadmap-service/package*.json ./services/roadmap-service/
COPY --from=builder /app/services/roadmap-service/dist ./services/roadmap-service/dist
RUN cd services/roadmap-service && npm install --omit=dev

# Billing
COPY --from=builder /app/services/billing-service/package*.json ./services/billing-service/
COPY --from=builder /app/services/billing-service/dist ./services/billing-service/dist
RUN cd services/billing-service && npm install --omit=dev

# Copy unified runner script
COPY --from=builder /app/start-backend.js ./start-backend.js

EXPOSE 4000
CMD ["node", "start-backend.js"]
